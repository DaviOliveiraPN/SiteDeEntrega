{
  // Type-checks the Deno-compatible shared modules and their Vitest tests.
  // Shared code must stick to Web APIs (crypto.subtle, fetch, Request) so it runs on Deno and Node.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.shared.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true
  },
  "include": ["supabase/functions/_shared", "tests/unit"]
}
